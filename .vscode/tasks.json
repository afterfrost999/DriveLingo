{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "말차: 에뮬레이터에서 실행",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/run.sh",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "말차: 실행 (차량 CarUx 실연동 모드)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/run.sh",
      "args": ["-Pdrivelingo.vehicleSource=car"],
      "problemMatcher": []
    },
    {
      "label": "말차: 실행 (Pleos 실연동: 차량 신호 + 음성)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/run.sh",
      "args": ["-Pdrivelingo.vehicleSource=car", "-Pdrivelingo.voiceSource=pleos"],
      "options": { "env": { "AVD": "Pleos_Connect_v2.1" } },
      "problemMatcher": []
    },
    {
      "label": "말차: Pleos Connect 에뮬레이터 설치",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/setup-pleos-emulator.sh",
      "problemMatcher": []
    },
    {
      "label": "말차: Pleos 에뮬레이터에서 CarUx 확인",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/check-car-ux.sh",
      "problemMatcher": []
    },
    {
      "label": "말차: 단위 테스트",
      "type": "shell",
      "command": "./gradlew :app:testDebugUnitTest --console=plain",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "말차: 로그 보기",
      "type": "shell",
      "command": "~/Library/Android/sdk/platform-tools/adb logcat -s LessonSession DebugVehicle CarUxRestrictions AndroidRuntime",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
