<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 프로토타입은 일반 에뮬레이터에서도 실행되도록 required=false. 차량 배포 시 true 로 바꾼다. -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Pleos Vehicle SDK 퍼미션. Pleos App Market 과 사전 협의해 승인된 범위만 배포할 수 있다(미승인, docs/policy-review.md).
        CAR_LIGHTS: TurnSignal(방향지시등) / CAR_DRIVE: Brake(브레이크 페달)
        CAR_SAFETY + PRIVATE_CAR_SAFETY: Safety 경고등. getTelltalesInfo 는 CAR_SAFETY,
        checkTelltalesCapabilities·registerTelltales 는 PRIVATE_CAR_SAFETY 를 요구한다(SDK 2.3.2 @RequiresPermission).
    -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <uses-permission android:name="pleos.car.permission.PRIVATE_CAR_SAFETY" />
    <!-- CAR_WINDOWS: Wiper(앞 와이퍼 → 비 보정). 전조등(야간 보정)은 CAR_LIGHTS. -->
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />

    <!-- AAOS CarPropertyManager. CAR_SPEED 는 런타임 권한이라 car 모드에서 MainActivity 가 요청한다. -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />

    <!-- Pleos SpeechToText / TextToSpeech SDK (voiceSource=pleos). -->
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <!--
        android:appCategory="audio": Pleos 문서 기준 Music/Audio 로 선언. Music/Audio 심사가 요구하는 MediaBrowserService·
        MediaSession·스티어링 휠 키는 feature/media/ 에 있다. 카테고리 적합성(마이크 대화 포함)은 docs/policy-review.md 참고.
    -->
    <application
        android:name=".app.DriveLingoApplication"
        android:allowBackup="false"
        android:appCategory="audio"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DriveLingo">

        <!-- AAOS Car API (CarUxRestrictionsManager). 차량 이미지에만 있으므로 선택 사항. -->
        <uses-library android:name="android.car" android:required="false" />

        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                주행 중 사용(DO) 선언. 선언하지 않으면 플랫폼이 주행 중 앱을 막는다.
                DO 선언 앱은 CarUxRestrictions 에 맞춰 직접 UX 를 제한해야 한다(이 앱은 DrivingMonitor 로 처리).
                실제 배포 시 DO 허용 여부는 심사 대상이다.
            -->
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>

        <!-- 차량 미디어 화면(Media Center)이 붙는 MediaBrowserService. 수업을 "오디오 레슨"으로 노출한다. -->
        <service
            android:name=".feature.media.LessonMediaService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
    </application>
</manifest>
